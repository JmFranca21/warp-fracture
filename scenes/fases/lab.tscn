theme = "lab"

[node name="Placa_02" type="Area2D" parent="Objetos"]
position = Vector2(520, 800)
script = ExtResource("17_kked3")
text = "Clique esquerdo (ou J) dispara o Estabilizador de Fase — a arma mira no cursor do mouse. Caixas quebram; barris EXPLODEM."
theme = "lab"

[node name="Placa_03" type="Area2D" parent="Objetos"]
position = Vector2(1410, 800)
script = ExtResource("17_kked3")
text = "Acertar inimigos carrega a ENERGIA DE FASE (clique direito = tiro carregado). Plataformas podem ser atravessadas por baixo; S + ESPAÇO desce delas."
theme = "lab"

[node name="Placa_04" type="Area2D" parent="Objetos"]
position = Vector2(2080, 800)
script = ExtResource("17_kked3")
text = "IRIS: \"O Terminal A está no alto desta sala. A alavanca no beiral religa o elevador.\""
theme = "lab"

[node name="Placa_05" type="Area2D" parent="Objetos"]
position = Vector2(2830, 800)
script = ExtResource("17_kked3")
