theme = "lab"

[node name="Placa_06" type="Area2D" parent="Objetos"]
position = Vector2(3545, 800)
script = ExtResource("17_kked3")
text = "IRIS: \"Um campo de força protege o Terminal B. A trava precisa de 1/3 da sua Energia de Fase.\""
theme = "lab"

