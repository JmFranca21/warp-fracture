[node name="Placa_01" type="Area2D" parent="Objetos"]
position = Vector2(330, 700)
script = ExtResource("2_wfaud")
text = "AUTÔMATO: lento e pesado, não recua ao levar dano. Clique esquerdo (ou J) dispara a REBITADEIRA."
theme = "deserto"

[node name="Placa_02" type="Area2D" parent="Objetos"]
position = Vector2(700, 700)
script = ExtResource("2_wfaud")
text = "F perto de uma argola ciano: o ÍMÃ DE FASE puxa você até ela. Segure a direção do outro lado: você atravessa o vão sozinho."
theme = "deserto"

[node name="Placa_03" type="Area2D" parent="Objetos"]
position = Vector2(1320, 700)
script = ExtResource("2_wfaud")
text = "ÍMÃ (F) sem argola ao alcance: puxa o DRONE marcado até o chão. Lá embaixo ele fica atordoado; no fosso ou num jato, explode."
theme = "deserto"

[node name="Placa_05" type="Area2D" parent="Objetos"]
position = Vector2(1520, 700)
script = ExtResource("2_wfaud")
text = "PULSO MAGNÉTICO (K ou clique direito, 1/3 de energia): onda curta em volta do corpo. Drones caem, robôs travam por 2 s, tiros estouram. O anel tracejado mostra o alcance."
theme = "deserto"

[node name="Placa_04" type="Area2D" parent="Objetos"]
position = Vector2(6560, 770)
script = ExtResource("2_wfaud")
text = "IRIS: \"A energia do fragmento vem de trás desta porta. É o núcleo da fábrica.\""
theme = "deserto"

[node name="Placa_06" type="Area2D" parent="Objetos"]
position = Vector2(6900, 770)
script = ExtResource("2_wfaud")
text = "PORTA IMANTADA: placas magnéticas travam a Câmara. Use o PULSO MAGNÉTICO perto delas."
theme = "deserto"

